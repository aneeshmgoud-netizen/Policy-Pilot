DATABASE_URL="postgresql://policy_pilot:policy_pilot@localhost:5432/policy_pilot?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000

# Shared secret the ingestion webhook (POST /api/v1/access-requests) checks
# against the X-API-Key header. Generate a local value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGESTION_API_KEY=

# AI layer (Phase 4/5)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
