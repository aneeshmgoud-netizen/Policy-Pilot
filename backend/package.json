{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "rag:ingest": "node --env-file=.env -r ts-node/register src/rag/scripts/ingest-policies.ts",
    "eval": "node --env-file=.env -r ts-node/register src/eval/run-eval.ts",
    "demo:requests": "node --env-file=.env -r ts-node/register src/ingestion/scripts/send-demo-requests.ts",
    "precedents:reindex": "node --env-file=.env -r ts-node/register src/precedents/scripts/reindex-precedents.ts",
    "queue:replay-failed": "node --env-file=.env -r ts-node/register src/queue/scripts/replay-failed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "reflect-metadata"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.80.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "gpt-tokenizer": "^3.4.0",
    "ioredis": "^5.11.1",
    "openai": "^6.48.0",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
